{
  "rules": {
    "destinations": {
      ".read": true,
      "$destinationId": {
        "reviews": {
          ".write": "auth != null"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
